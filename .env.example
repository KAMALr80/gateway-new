APP_NAME=Gateway
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

# Middleware's own database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=gateway
DB_USERNAME=root
DB_PASSWORD=

# ERP's database (shared, read for nothing — ERP writes to us directly)
DB_ERP_HOST=127.0.0.1
DB_ERP_PORT=3306
DB_ERP_DATABASE=erp_db
DB_ERP_USERNAME=erp_readonly_user  # give only SELECT if you ever need to read
DB_ERP_PASSWORD=another_strong_password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis

# JWT
JWT_SECRET=                     # filled by php artisan jwt:secret
JWT_TTL=1440                    # 24 hours in minutes
JWT_REFRESH_TTL=20160           # 14 days

# ERP order webhook (the existing URL your ERP exposes)
ERP_ORDER_WEBHOOK_URL=https://your-erp-domain.com/api/orders/receive
ERP_WEBHOOK_SECRET=shared_secret_for_hmac

# Internal API security (ERP uses this key when calling middleware)
INTERNAL_API_KEY=long_random_secret_for_erp_sync_calls